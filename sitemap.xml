    <loc>https://example.comcategory/laptops</loc>
    <lastmod>2026-10-25</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- Категория «Смартфоны»: важный раздел, обновляется еженедельно -->
